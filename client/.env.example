# ---------------------------------------------------------------------------
# Reneo frontend environment
#
# Every variable here is NEXT_PUBLIC_, which means Next.js inlines it into the
# JavaScript bundle at build time. Anything added to this file is therefore
# PUBLIC — readable by anyone who opens the site. Never put a service-role key,
# database password or API secret in this file or in .env.local.
#
# The frontend does not need a privileged credential. It calls the Express API
# with the user's own Supabase JWT, and PostgreSQL Row Level Security decides
# what that user may see. See the root README for the reasoning.
#
# Copy to .env.local for local development. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Base URL of the Express API (no trailing slash).
# Local development: the API defaults to port 4000 (server/.env PORT).
# Production: the public origin of the deployed API, e.g. https://api.reneo.example
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key.
# Public by design: it identifies the project, not a user, and grants nothing on
# its own. Every table has RLS enabled, so this key can only ever read what the
# signed-in user's policies allow. Do NOT use the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
