SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Port the API listens on. Hosts that assign one (Render, Fly, Heroku) set this
# themselves — leave it unset there.
PORT=4000

# Extra browser origins allowed to call this API, comma-separated.
#
# OPTIONAL. The built-in defaults already cover local development and this
# project's deployed frontend (see DEFAULT_ORIGINS in src/index.ts), so the API
# works unconfigured. Anything set here is ADDED to those defaults, never
# replaces them — so adding a staging origin cannot silently cut off production.
#
# No trailing slash. `*` matches within one hostname segment:
#
#   CORS_ORIGINS=https://staging.example.com,https://reneo-*.vercel.app
#
# The API logs its full allow-list at boot, and logs every refused origin.
# CORS_ORIGINS=
