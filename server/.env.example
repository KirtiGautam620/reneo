SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Port the API listens on. Hosts that assign one (Render, Fly, Heroku) set this
# themselves — leave it unset there.
PORT=4000

# Comma-separated list of browser origins allowed to call this API.
#
# REQUIRED IN PRODUCTION. Unset, it defaults to the local dev ports only, and a
# deployed frontend is refused with "No 'Access-Control-Allow-Origin' header is
# present on the requested resource".
#
# No trailing slash. `*` matches within one hostname segment, which covers
# Vercel preview deployments whose subdomain changes per branch:
#
#   CORS_ORIGINS=https://reneo-delta.vercel.app,https://reneo-*.vercel.app
#
# Local development (the default):
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
